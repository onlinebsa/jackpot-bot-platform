# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key: server-only, NEVER expose to the browser. Used only in
# src/lib/supabase/admin.ts for privileged admin actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay payment links (from your Razorpay dashboard)
NEXT_PUBLIC_RAZORPAY_MONTHLY_LINK=https://rzp.io/rzp/rfD9LGS
NEXT_PUBLIC_RAZORPAY_ONETIME_LINK=https://rzp.io/rzp/55WNUWz

# Admin WhatsApp number used for wa.me links (with country code, no +, no spaces)
NEXT_PUBLIC_ADMIN_WHATSAPP=919999999999
